<?php 
$t_id=$lrow['tag_id']; 
function is_child1($tag_id)
{
	$sql="SELECT * FROM tags WHERE is_child='".$tag_id."'";
	$ex=mysql_query($sql);	
	
	if(mysql_num_rows($ex)>0)
	{
		echo "<ul>";
		while($rows=mysql_fetch_array($ex))
		{
		?>
			<li class="tags"><span id="tag_<?php echo $rows['tag_id']; ?>"><?php if($GLOBALS['t_id']==$rows['tag_id']) { ?> <img src="https://planitlocations.com/crm/images/right-sign.png" /><?php }  ?><?php echo $rows['tag_name']; ?></span>
			<span>
			<div style="width:100px;height:25px;text-align:center;background-color:<?php echo $rows['color_code']; ?>"><?php echo $row['color_code']; ?></div>
			</span>
			<span>
			<a href="add-tag.php?id=<?php echo $rows['tag_id']?>" class="n">Edit</a> &nbsp; | &nbsp; <a href="javascript:if(confirm('Are you sure you want to delete it?')){window.location='tags.php?id=<?php echo $rows['tag_id']?>&del=delete'}" class="n">Delete</a>
			</span>
			<?php 				
				is_child1($rows['tag_id']);									
			?>
			</li>
<?php 
		}
		echo "</ul>";
	}
}
