<script type="text/javascript">
jQuery(document).ready(function(){
jQuery.ajax({ 
		type : 'POST',
		url : 'ajax_tag.php',					
		data : 
		{ 
			action : 'hierarchical',
		},
		beforeSend: function()
		{
			jQuery("#hierarchical").html('<img src="https://planitlocations.com/crm/images/ajax-loader.gif">');	
		},			
		success : function(data)
		{
			jQuery("#hierarchical").html(data);
			jQuery(".sel_parent").html('<span>'+'&nbsp;'+'</span>');
		}				
	});
	jQuery("#sel_parent").live("click", function(){
		if(!jQuery(".subSelCatg").is(":visible")){
			jQuery(".subSelCatg").show();
		}else{
			jQuery(".subSelCatg").hide();	
		}
	});
	jQuery(".subSelCatg li").live("click", function(){
		jQuery(".subSelCatg").hide();	
	});
	jQuery(".tags span").live("click", function(){
		var tagID=jQuery(this).attr('id');
		var split=tagID.split('_');
		var thisHtml = jQuery(this).html();
		jQuery(".is_child").val(split[1]);
		jQuery( ".is_nested" ).attr( "checked", "checked" );
		jQuery(".sel_parent").html('<span>' + thisHtml + '</span>');
		jQuery(".is_enabled").removeAttr('disabled');
	});
	jQuery("#is_nested").live("click", function(){
		firstcheckbox();
	});
	jQuery("#sub").live('click',function(){ 	
		if(jQuery('#tag_name').val()=='')
		{
			alert('Please enter tag name');
			return false;
		}
		else 
		{
			jQuery("#form1").submit();
		}	
	});
});
function firstcheckbox(){
	if(jQuery("#is_nested").is(':checked')==true){ 
		jQuery(".sel_parent").html('<span>Please select a parent</span>');
		jQuery("#sub").attr('disabled','disabled');
	}
	else 
	{
		jQuery(".sel_parent").html('<span></span>');
		jQuery(".subSelCatg").hide();
		jQuery("#is_child").val('0');
		jQuery("#is_nested").removeAttr('checked');
		jQuery("#sub").removeAttr('disabled');
	}
}
function edit_close()
{
	location.href="https://planitlocations.com/crm/tags.php";
}
</script>
