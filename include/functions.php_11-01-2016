 function getHttpVars() {
		$superglobs = array(
			'_POST',
			'_REQUEST',
			'_GET',
			'_FILES',
			'HTTP_POST_VARS',
			'HTTP_GET_VARS');
		$httpvars = array();
		// extract the right array
		foreach ($superglobs as $glob) {
			global $$glob;
			if (isset($$glob) && is_array($$glob)) {
				$httpvars = $$glob;
			 }
			if (count($httpvars) > 0)
				break;
		}
		return $httpvars;
	}
