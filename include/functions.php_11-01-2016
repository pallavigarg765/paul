function getAllParentsChildsTags($allPostedTags)
{
	$arrTags=array();
	if(count($allPostedTags)>0)
	{
		for($cnt=0;$cnt<count($allPostedTags);$cnt++)
		{ 
			$getAllChild=getAllChild($allPostedTags[$cnt]);
			array_push($arrTags,$getAllChild);
		}
	}
	$arr_pop=array_pop($arrTags);
	$mergeArray=array_merge($allPostedTags,$arr_pop);
	return $mergeArray;
}
function getAllChild($tag_id) 
{    
	static $arr =array(); 
	$sql="SELECT * FROM planitlo_crm.tags WHERE is_child='".$tag_id."'";
	$ex=mysql_query($sql);	
	if(mysql_num_rows($ex) > 0) 
	{	
		while($row = mysql_fetch_array($ex)) 
		{
			$arr[]=$row['tag_id'];
			getAllChild($row['tag_id']);
        }
    }
    return $arr;
}
