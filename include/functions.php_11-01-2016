function listbox_array($array,$name, $default='',$strname='0') {
    if($strname == '0')
		$result="<select name=\"$name\" class=\"dropdown\">";
    if($default == '' || $default == '0'){
		$result.= '<option value="" selected>--None--</option>';
	}else{
		$result.= '<option value="">--None--</option>';
	}
	foreach ($array as $key => $valueR) {
        if ($default  == $valueR) {$selected="selected";} else {$selected="";}
        $result.="<option value=\"$key\" $selected>$valueR</option>";
    }
	if($strname == '0')
    	$result.="</select>";
return $result;
}
function listbox_day ($name, $default=0) {
    $result="<select name=".$name." class=clsvvday>";
    if($default == 0){
		$result.= "<option value=0 selected>Day</option>";
	}
	for ($d=1;$d<=31;$d++) {
        if ($default  == $d) {$selected="selected";} else {$selected="";}
        if ($d < 10 && strlen($d) < 2)
			$d = '0'.$d;
		$result.="<option value=".$d." $selected>$d</option>";
    }
    $result.="</select>";
return $result;
}

function listbox_month ($name, $default=0) {
    $result="<select name=".$name." class=clsvv2>";
    if($default == 0){
		$result.= "<option value=0 selected>Month</option>";
	}
	for ($m=1;$m<=12;$m++) {
        if ($default  == $m) {$selected="selected";} else {$selected="";}
        if ($m < 10 && strlen($m) < 2)
			$m = '0'.$m;
		$result.="<option value=".$m." $selected>".date(F, mktime(0,0,0,$m,1,2000))."</option>";
    }
    $result.="</select>";
return $result;
}

function listbox_year ($name, $start, $end, $default=0) {
    $result="<select name=".$name." class=clsvvyear>";
	//if($default == 0){
		$result.= "<option value=0>Year</option>";
	for ($y=$end;$y>=$start;$y--) {
        if ($default  == $y) {$selected="selected";} else {$selected="";}
        $result.="<option value=".$y." $selected>$y</option>";
    }
    $result.="</select>";
return $result;
}

function ReturnName($TableName,$FieldName,$IDField,$ID){
	$retName="";
	$strQry="SELECT $FieldName FROM $TableName  WHERE $IDField=$ID";
	$nResult =mysql_query($strQry) or die("Unable 2 Work ".$strQry);

	if (mysql_num_rows($nResult)>=1){
		$row=mysql_fetch_object($nResult);
		$retName=$row->$FieldName;
	}	
	
	return $retName;		
 }
function upload_file($strElementName,$strPath){
	// $userfile is where file went on webserver
	$userfile = $_FILES[$strElementName]['tmp_name'];
	// $userfile_name is original file name
	$userfile_name = $_FILES[$strElementName]['name'];
	// $userfile_size is size in bytes
	$userfile_size = $_FILES[$strElementName]['size'];
	// $userfile_type is mime type e.g. image/gif
	$userfile_type = $_FILES[$strElementName]['type'];
	// $userfile_error is any error encountered
	$userfile_error = $_FILES[$strElementName]['error']; 
			
	// userfile_error was introduced at PHP 4.2.0
	// use this code with newer versions 
			
	if ($userfile_error > 0) {
		switch ($userfile_error){ 
			case 1:
				$strMessage="Problem :: File exceeded maximum file size(2MB)";
				break;
			case 2:
				$strMessage="Problem :: File exceeded maximum file size(2MB)";
				break;
			case 3:
				$strMessage="Problem :: File only partially uploaded";
				break;
			case 4:
				$strMessage="Problem :: No file uploaded";
				break;
		}
		return $strMessage;
	} 
			
		
	// is_uploaded_file and move_uploaded_file
	if (is_uploaded_file($userfile)){
		if (!move_uploaded_file($userfile, $strPath)){
			$strMessage="Problem: Could not move file to destination directory";
			return $strMessage;
		}
	} 
	else {
		$strMessage="Problem: Possible file upload attack. Filename: ".$userfile_name;
		return $strMessage;
	}
	$strMessage="";
	return $strMessage;
}

