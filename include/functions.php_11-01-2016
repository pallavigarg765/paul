/* Combo Generation function*/

function fillCombo($strCboName,$strTable,$numValueField,$strDisplayField,$strWhereClause,$numSelected,$strCssClass,$strJS,$strname='0', $strid=''){
	
	if($strname == '0')
		print("<select name=\"$strCboName\" id=\"$strid\" class=\"$strCssClass\" $strJS>"); 
	print("<option value=\"\" selected>- Select -</option>");

	$strQuery="SELECT $numValueField AS ID,$strDisplayField AS VALUE FROM $strTable $strWhereClause";

	//print($strQuery);
	$strResult =mysql_query($strQuery) or die("Unable 2 Work");
	

	if (mysql_num_rows($strResult)>=1){ // if of number of rows checking

		while ($row=mysql_fetch_object($strResult)){ // start while

			if ($row->ID==$numSelected){
				print("<option value=\"$row->ID\" selected>".addslashes($row->VALUE)."</option>");
			}
			else{
				print("<option value=\"$row->ID\">".addslashes($row->VALUE)."</option>");
			}
		}// end while

	}// end if number of rows checking
			
	if($strname == '0')
		print("</select>");

} 

