 function getHttpVars() {
		$superglobs = array(
			'_POST',
			'_REQUEST',
			'_GET',
			'_FILES',
			'HTTP_POST_VARS',
			'HTTP_GET_VARS');
		$httpvars = array();
		// extract the right array
		foreach ($superglobs as $glob) {
			global $$glob;
			if (isset($$glob) && is_array($$glob)) {
				$httpvars = $$glob;
			 }
			if (count($httpvars) > 0)
				break;
		}
		return $httpvars;
	}
function CheckUSPhoneNum( $PhoneNumber )
 {
        $PhoneNumber = ereg_replace( "[^0-9]", "", $PhoneNumber ); // Strip out non-numerics    

        if( ereg( "^([0-9]{3})([0-9]{3})([0-9]{4})$", $PhoneNumber, $NumberParts ) )                                   
                return "(" . $NumberParts[1] . ") " . $NumberParts[2] . "-" . $NumberParts[3];
        else
                return $PhoneNumber;
}
