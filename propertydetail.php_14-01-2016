	function checkThird($s, $thirdValue){
		$count = 0;
		for($i = 0; $i < count($s); $i++){
			if($s[$i] != ""){
				$sql = "SELECT prop_name3 FROM prop_info WHERE prop_name = '".$s[$i]."'";
				if($res = mysql_query($sql)){
					$row = mysql_fetch_array($res);
					
					if($thirdValue == ""){ //empty
						if($row['prop_name3'] != ""){
							break;
						}
					}else if($thirdValue == "-"){ //dash
						if($row['prop_name3'] == "-"){
							$count--;
							break;
						}
					}else{ //city name
						if(($row['prop_name3'] != "") && ($row['prop_name3'] != "-")){
							//$count--;
							break;
						}
					}
					$count++;
				}else{
					echo mysql_error();
				}
			}
		}
		return $count;
	}
	
	//finds the position of a property name in new sorting
	function findLocation($s, $propName){
		$count = 0;
		for($i = 0; $i < count($s); $i++){
			if(strtolower($s[$i]) == strtolower($propName)){
				break;
			}
			$count++;
		}
		return $count;
	}
	
