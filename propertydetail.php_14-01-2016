	function endsWith(str, suffix) {
		return str.indexOf(suffix, str.length - suffix.length) !== -1;
	}
	
	function inSameType(parent){
		var arr = new Array();
		jQuery(parent).find(".cboPickCategory").each(function(){
			var pickCat = jQuery(this).val();
			var arrPickCat = pickCat.split("-");
			if(arrPickCat.length > 0){
				arr.push(arrPickCat[arrPickCat.length - 1]);
			}else{
				arr.push(pickCat);
			}
			console.log(pickCat);
		});
		
		var checkNum = 0; 
		for(i=0; i< arr.length; ++i){     
			if(arr[0] == arr[i]){
				++checkNum;
			} 
		}
		
		if(checkNum==arr.length){     
			return true;
		}
		
		//not same minus type
		//continue with z
		checkNum = 0;
		for(i = 0; i < arr.length; i++){
			if(endsWith(arr[i], "Z")){
				checkNum++;
			}
		}
		if(checkNum==arr.length){     
			return true;
		}
		
		//check if prv types
		checkNum = 0;
		for(i = 0; i < arr.length; i++){
			if(endsWith(arr[i], "prv")){
				checkNum++;
			}
		}
		if(checkNum==arr.length){     
			return true;
		}
		
		//check if -a type
		checkNum = 0;
		for(i = 0; i < arr.length; i++){
			if(arr[i].length > 2 && !endsWith(arr[i], "Z") && !endsWith(arr[i], "prv")){
				//it's an -a type
				checkNum++;
			}
		}
		
		if(arr.length == checkNum){
			return true;
		}
		
		return false;
	}
	
	
